# Copy to .env and fill in. Never commit .env.

# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

DEBUG=True

# Comma-separated. Required in production, where there is no default —
# a missing value fails at boot rather than accepting any Host header.
ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to SQLite when unset. PostgreSQL is the supported target:
# DATABASE_URL=postgres://isp:isp@localhost:5432/isp

# Celery. In dev, tasks run inline unless CELERY_EAGER=False.
CELERY_EAGER=True
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Router credential encryption (P1). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means every stored router password becomes unreadable.
ROUTER_CRED_KEY=

# Production only
# CSRF_TRUSTED_ORIGINS=https://isp.example.com
